{
    "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
    "files": {
        "includes": [
            "**",
            "!**/node_modules",
            "!**/dist",
            "!**/.turbo",
            "!**/.codegraph"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "overrides": [
        {
            "includes": ["**/jsr.json"],
            "json": {
                "formatter": {
                    "expand": "always"
                }
            }
        }
    ],
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended"
        }
    }
}
