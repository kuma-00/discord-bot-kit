{
    "name": "discord-bot-kit",
    "version": "1.2.0",
    "license": "MIT",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.3.13",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "check": "turbo run check && biome check . && tsc -p tsconfig.json && bun run check:boundaries",
        "check:boundaries": "bun test tests/package-boundaries.test.ts",
        "test": "turbo run test && bun test tests",
        "biome:write": "turbo run biome:write && biome check --write .",
        "jsr:dry-run": "bun scripts/jsr-dry-run.ts",
        "jsr:publish": "bun scripts/jsr-publish.ts"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.14",
        "@types/bun": "1.3.13",
        "turbo": "2.9.1",
        "typescript": "7.0.2"
    }
}
