{
    "name": "discord-bot-kit",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.3.13",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "check": "turbo run check && bun run check:boundaries",
        "check:boundaries": "bun test tests/package-boundaries.test.ts",
        "test": "turbo run test",
        "biome:write": "turbo run biome:write",
        "jsr:dry-run": "bun scripts/jsr-dry-run.ts"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.14",
        "@types/bun": "1.3.13",
        "turbo": "2.9.1",
        "typescript": "7.0.2"
    }
}
